{
  "name": "@hono-modules/cli",
  "version": "0.1.0",
  "description": "CLI for hono-modules",
  "author": "hono-modules authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hono-modules/hono-modules.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hono-modules/hono-modules",
  "bugs": {
    "url": "https://github.com/hono-modules/hono-modules/issues"
  },
  "keywords": [
    "hono",
    "cli",
    "modules",
    "features"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "hm": "./dist/index.js",
    "hono-modules": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@repo/eslint-config": "*",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.2"
  }
}
