{
  "name": "hono-modules",
  "version": "0.1.0",
  "description": "A lightweight module and feature manager for HonoJS applications",
  "author": "hono-modules authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hono-modules/hono-modules.git"
  },
  "homepage": "https://github.com/hono-modules/hono-modules",
  "bugs": {
    "url": "https://github.com/hono-modules/hono-modules/issues"
  },
  "keywords": [
    "hono",
    "modules",
    "features"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@repo/eslint-config": "*",
    "@types/node": "^22.0.0",
    "hono": "^4.0.0",
    "typescript": "^5.9.2"
  }
}
